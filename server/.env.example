# LLM 配置（统一 LLM_ 前缀，DeepSeek 兼容格式）
# API 密钥（必填）
LLM_API_KEY=sk-xxxx

# API 地址（可选，DeepSeek 官方；兼容 OpenAI 格式的中转服务如火山方舟也可）
# LLM_BASE_URL=https://api.deepseek.com

# 模型 ID（可选）
# LLM_MODEL=deepseek-flash

# 单次回答 token 上限（可选，0 表示不限制）
# LLM_MAX_TOKENS=64000

# 系统提示词（可选）
# LLM_SYSTEM_PROMPT=你是一个乐于助人的中文助手。

# 思考模式：enabled / disabled（可选）
# LLM_THINKING=disabled

# 推理深度：low / medium / high（可选）
# LLM_REASONING_EFFORT=high

# 服务端口
PORT=3000

# ==============================
# ASR 语音识别配置（兼容 OpenAI Whisper API 格式）
# ==============================
# API 密钥（必填，未配置时调用语音识别接口会报错）
ASR_API_KEY=

# API 地址（可选，默认 OpenAI 官方；兼容 Whisper 格式的服务都可）
# 硅基流动示例：https://api.siliconflow.cn/v1
# ASR_BASE_URL=https://api.siliconflow.cn/v1

# 模型 ID（可选，默认 whisper-1）
# 硅基流动 SenseVoice 示例：FunAudioLLM/SenseVoiceSmall
# ASR_MODEL=FunAudioLLM/SenseVoiceSmall

# 识别语言（可选，zh=中文，en=英文；留空则自动检测）
# ASR_LANGUAGE=zh
